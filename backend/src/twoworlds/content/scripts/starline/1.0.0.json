  "endings": [
    {
      "id": "rescue_detour",
      "scene_id": "completed",
      "summary_template": "你们让回声穿过失落站台，定位并修复导轨，交换灯号完成接车。两人一致决定绕行救援：末班列车转入支线，将仍在等待的人也带回灯火。"
    },
    {
      "id": "return_station",
      "scene_id": "completed",
      "summary_template": "你们分配有限能源，先勘测、后接车，让末班列车抵达二号轨。两人一致决定直接归站：不再追逐更远的回声，先把彼此和这趟列车安全送回家。"
    }
  ],
  "npc": {
    "name": "末班报站员",
    "public_persona": "只依据当前角色获准的事实提醒协作，不替玩家修改装置、预算或结局。",
