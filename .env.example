# ==============================================================================
# TwoWorlds Environment Configuration Example
# ==============================================================================
# Copy this file to .env (or supply these via your container orchestration environment).
# The application requires an explicit runtime mode: 'production' or 'demo'.
# Note: The application does NOT read .env automatically in production; environment
# variables must be injected by Docker Compose, Kubernetes, or your process supervisor.

# ------------------------------------------------------------------------------
# 1. Core Runtime Mode (Required: 'production' or 'demo')
# ------------------------------------------------------------------------------
# - production: Requires TWOWORLDS_STORAGE_BACKEND=mongo and valid MONGO_URI.
#               If MongoDB is unavailable, the backend exits immediately with code 1.
# - demo:       Requires TWOWORLDS_STORAGE_BACKEND=sqlite and TWOWORLDS_SQLITE_PATH.
#               Enforces TWOWORLDS_AI_MODE=demo (zero external AI calls / cost).
TWOWORLDS_MODE=production

# ------------------------------------------------------------------------------
# 2. Server Host and Port
# ------------------------------------------------------------------------------
TWOWORLDS_HOST=0.0.0.0
TWOWORLDS_PORT=8000

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins (Comma-separated exact origins)
# ------------------------------------------------------------------------------
TWOWORLDS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 4. Storage Configuration
# ------------------------------------------------------------------------------
# Storage backend: 'mongo' (production) or 'sqlite' (demo)
TWOWORLDS_STORAGE_BACKEND=mongo

# MongoDB settings (Mandatory when TWOWORLDS_STORAGE_BACKEND=mongo)
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=twoworlds

# SQLite settings (Mandatory when TWOWORLDS_STORAGE_BACKEND=sqlite)
# For Docker demo container, use /data/twoworlds_demo.db inside the persistent volume.
TWOWORLDS_SQLITE_PATH=/data/twoworlds_demo.db

# ------------------------------------------------------------------------------
# 5. Security & Verification Secret
# ------------------------------------------------------------------------------
# In production mode, this MUST be a cryptographically secure random string
# with at least 16 characters. The backend rejects an empty or short value.
#
# Generate a secure value with:
#   openssl rand -hex 32
#
# Never use the placeholder below as a real secret. Leave it empty here so
# that any accidental copy-paste of this file is immediately rejected by the
# backend validation.
TWOWORLDS_VERIFICATION_SECRET=

# ------------------------------------------------------------------------------
# 6. Email Service Mode ('console' or 'smtp')
# ------------------------------------------------------------------------------
# 'console'  — prints verification codes to stdout/logs.
#              Use in demo / local development only.
# 'smtp'     — sends real email via SMTP.
#              Required for production. Provide all SMTP_* vars below.
TWOWORLDS_EMAIL_MODE=smtp

# SMTP settings (required when TWOWORLDS_EMAIL_MODE=smtp)
# Generate a secure app password from your mail provider.
# SMTP_PORT defaults to 587 (STARTTLS) if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# 7. AI Narrative Provider Configuration
# ------------------------------------------------------------------------------
# In demo mode, this is strictly enforced to 'demo'.
# In production mode, set to 'demo' or 'provider'.
TWOWORLDS_AI_MODE=demo
TWOWORLDS_AI_PROVIDER=openai_compatible
TWOWORLDS_AI_BASE_URL=
TWOWORLDS_AI_MODEL=
TWOWORLDS_AI_API_KEY=
TWOWORLDS_AI_TIMEOUT_SECONDS=2
TWOWORLDS_AI_MAX_INPUT_TOKENS=
TWOWORLDS_AI_MAX_OUTPUT_TOKENS=
TWOWORLDS_AI_MAX_REQUEST_COST_USD=
TWOWORLDS_AI_DAILY_BUDGET_USD=
TWOWORLDS_AI_MAX_DAILY_CALLS=200
TWOWORLDS_AI_PRICE_VERSION=
TWOWORLDS_AI_INPUT_USD_PER_MILLION=
TWOWORLDS_AI_OUTPUT_USD_PER_MILLION=

# ------------------------------------------------------------------------------
# 8. Frontend Configuration (Docker build argument)
# ------------------------------------------------------------------------------
# Passed as --build-arg VITE_API_BASE_URL=... when building frontend Docker image
VITE_API_BASE_URL=http://localhost:8000
