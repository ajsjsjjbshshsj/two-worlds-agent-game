include /etc/twoworlds/proxy-http.conf;

server {
    listen 80 default_server;
    server_name ${TWOWORLDS_PUBLIC_HOST};

    if ($host != $server_name) { return 421; }
    return 308 https://${TWOWORLDS_PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 421;
}

server {
    listen 443 ssl;
    server_name ${TWOWORLDS_PUBLIC_HOST};

    include /etc/twoworlds/tls-server.conf;

    if ($host != $server_name) { return 421; }

    include /etc/twoworlds/proxy-locations.conf;
}
