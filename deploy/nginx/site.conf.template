map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Docker DNS allows recovery after either application container is recreated.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream twoworlds_api {
    zone twoworlds_api 64k;
    server backend:8000 resolve;
}

upstream twoworlds_ui {
    zone twoworlds_ui 64k;
    server frontend:8080 resolve;
}

server_tokens off;
ssl_protocols TLSv1.2 TLSv1.3;
access_log off;
# Upstream errors can include the original URL and query string.
error_log /dev/null crit;

server {
    listen 80 default_server;
    server_name ${TWOWORLDS_PUBLIC_HOST};

    if ($host != $server_name) { return 421; }
    return 308 https://${TWOWORLDS_PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 421;
}

server {
    listen 443 ssl;
    server_name ${TWOWORLDS_PUBLIC_HOST};

    ssl_certificate /etc/twoworlds-tls/fullchain.pem;
    ssl_certificate_key /etc/twoworlds-tls/privkey.pem;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    if ($host != $server_name) { return 421; }

    location ~ ^/api(?:/|$) {
        client_max_body_size 16k;
        proxy_pass http://twoworlds_api;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;

        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Probes are reached directly from inside the backend container.
    location ~ ^/health(?:/|$) {
        return 404;
    }

    location / {
        proxy_pass http://twoworlds_ui;
        proxy_set_header Host $server_name;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
    }
}
